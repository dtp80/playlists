# Server Configuration
PORT=8084
NODE_ENV=production

# Local SQLite (same idea as EPG Handler's data/*.db).
# Paths are resolved against the project root; prefer data/playlists.db on Synology.
DATABASE_URL="file:./data/playlists.db"

# Session Secret
# Generate a secure random string for production (minimum 32 characters recommended)
SESSION_SECRET="your-secret-key-change-in-production-use-strong-random-string"

# API key for /api/v1/* and remote diagnostics (X-API-Key / Bearer)
# Generate in Settings → API, or set a long random hex string here.
API_KEY=""

# Optional: base URL used by local tooling to hit the Synology instance
API_BASE_URL="http://172.16.0.200:8084"
